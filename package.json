{
  "name": "caesar-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:types": "tsx scripts/gen-content-types.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "prebuild": "npm run gen:types && npm run gen:og-font && tsx scripts/validate-content.ts --production",
    "dev": "next dev",
    "build": "CONTENT_GATE=production next build",
    "build:draft": "ALLOW_PLACEHOLDER_MEDIA=1 next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "media:optimize": "tsx scripts/optimize-media.ts",
    "media:check": "tsx scripts/optimize-media.ts --check",
    "shots": "playwright test",
    "shots:update": "playwright test --update-snapshots",
    "prebuild:draft": "npm run gen:types && npm run gen:og-font && tsx scripts/validate-content.ts",
    "gen:og-font": "tsx scripts/gen-og-font.ts"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.2.5",
    "bidi-js": "^1.1.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "ffmpeg-static": "^5.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4"
  ]
}
