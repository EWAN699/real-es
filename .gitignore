# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# build output
dist/
build/

# environment — never commit real secrets
.env
.env.*
!.env.example

# playwright
test-results/
playwright-report/
blob-report/
.playwright/
screenshots/

# media sources (originals are large; shipped derivatives live in public/media/)
assets/source/

# raw generator output staged under public/media/ for `npm run media:optimize`.
# Only the derivatives it writes (.webp/.avif/.mp4/.webm/-poster.webp) ship.
public/media/**/*.png
public/media/**/*.tif
public/media/**/*.tiff
public/media/**/*.mov

# misc
*.log
.DS_Store
*.tsbuildinfo
.vercel
