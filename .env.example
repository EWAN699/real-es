# Kling AI — image generation (https://api.klingai.com)
#
# Copy to .env.local and fill in. NEVER prefix these with VITE_: Vite inlines
# any VITE_* value into the client bundle, which would publish your secret key.
# These are read by scripts/images/generate.ts in Node, never by the browser.
#
# The generation script signs a short-lived HS256 JWT from this pair and sends
# it as `Authorization: Bearer <jwt>`.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Optional: pin the image model. Leave unset to use the default in
# scripts/images/config.ts. Verify current names against Kling's live docs —
# they change between releases.
# KLING_IMAGE_MODEL=

# Lead form delivery (serverless function, not the client)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@caesar.co.il
