# Copy to .env.local for local dev. NEVER commit a real .env file.

# Canonical origin, used for sitemap/robots/OG absolute URLs.
NEXT_PUBLIC_SITE_URL=https://caesar.example.com

# --- Contact form email provider -------------------------------------------
# console  : log the submission to the server console (default, no network)
# resend   : POST to the Resend API (requires EMAIL_API_KEY)
# smtp     : reserved; not implemented yet, route returns 501
EMAIL_PROVIDER=console
EMAIL_API_KEY=
CONTACT_TO_EMAIL=info@caesar.co.il
CONTACT_FROM_EMAIL=website@caesar.co.il

# --- Build gates ------------------------------------------------------------
# Set to 1 to let a production build pass while media still carries
# origin: "placeholder". Intended only for the pre-asset phase; the deploy
# pipeline must never set it.
# ALLOW_PLACEHOLDER_MEDIA=1
